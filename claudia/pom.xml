<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.quaxt.claudia</groupId>
    <artifactId>claudia-parent</artifactId>
    <version>0.1.0</version>
  <relativePath>../pom.xml</relativePath></parent>
  <artifactId>claudia</artifactId>
  <packaging>jar</packaging>
  <name>claudia</name>
  <description>Java port of the pi coding agent CLI</description>
  <properties>
    <claudia.distributionDirectory>${project.basedir}/../target</claudia.distributionDirectory>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.quaxt</groupId>
      <artifactId>agentic</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!--
	PDF text extraction and page rendering for the read tool. Used only by
	cli.tools.media.DesktopMediaReader, which is loaded reflectively so the
	native image never includes it (or AWT).
    -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Keep the thin JAR away from the runnable JAR's stable path. -->
    <finalName>claudia-thin</finalName>
    <plugins>
      <plugin>
	<groupId>org.apache.maven.plugins</groupId>
	<artifactId>maven-compiler-plugin</artifactId>
	<version>3.15.0</version>
      </plugin>
      <plugin>
	<groupId>org.apache.maven.plugins</groupId>
	<artifactId>maven-surefire-plugin</artifactId>
	<version>3.5.6</version>
	<configuration>
	  <!-- The POSIX terminal tests call termios through the foreign-function API. -->
	  <argLine>--enable-native-access=ALL-UNNAMED -Djava.awt.headless=true</argLine>
	</configuration>
      </plugin>
      <plugin>
	<groupId>org.apache.maven.plugins</groupId>
	<artifactId>maven-shade-plugin</artifactId>
	<version>3.6.2</version>
	<executions>
	  <execution>
	    <phase>package</phase>
	    <goals>
	      <goal>shade</goal>
	    </goals>
	    <configuration>
	      <!--
		  Never write directly to claudia.jar: a running JVM loads classes
		  lazily, so mutating that archive can make classes disappear
		  mid-session. Shade writes a temporary file first; the following
		  execution publishes it with a rename, preserving the inode used
		  by any already-running process.
	      -->
	      <outputFile>${claudia.distributionDirectory}/claudia.next.jar</outputFile>
	      <createDependencyReducedPom>false</createDependencyReducedPom>
	      <transformers>
		<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
		  <mainClass>com.quaxt.claudia.ClaudiaCli</mainClass>
		  <manifestEntries>
		    <!-- The interactive terminal controls the tty through java.lang.foreign. -->
		    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
		  </manifestEntries>
		</transformer>
		<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
	      </transformers>
	      <filters>
		<filter>
		  <artifact>*:*</artifact>
		  <excludes>
		    <exclude>META-INF/*.SF</exclude>
		    <exclude>META-INF/*.DSA</exclude>
		    <exclude>META-INF/*.RSA</exclude>
		  </excludes>
		</filter>
	      </filters>
	    </configuration>
	  </execution>
	</executions>
      </plugin>
      <plugin>
	<groupId>org.apache.maven.plugins</groupId>
	<artifactId>maven-antrun-plugin</artifactId>
	<version>3.1.0</version>
	<executions>
          <execution>
            <id>prepare-distribution-directory</id><phase>prepare-package</phase>
            <goals><goal>run</goal></goals>
            <configuration><target><mkdir dir="${claudia.distributionDirectory}"/></target></configuration>
          </execution>
	  <execution>
	    <id>publish-shaded-jar</id>
	    <phase>package</phase>
	    <goals>
	      <goal>run</goal>
	    </goals>
	    <configuration>
	      <target>
		<move
		    file="${claudia.distributionDirectory}/claudia.next.jar"
		    tofile="${claudia.distributionDirectory}/claudia.jar"/>
	      </target>
	    </configuration>
	  </execution>
	</executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native</id>
      <build>
	<plugins>
	  <plugin>
	    <groupId>org.graalvm.buildtools</groupId>
	    <artifactId>native-maven-plugin</artifactId>
	    <version>${native-maven-plugin.version}</version>
	    <extensions>true</extensions>
	    <executions>
	      <execution>
		<id>build-native</id>
		<goals>
		  <goal>compile-no-fork</goal>
		</goals>
		<phase>package</phase>
	      </execution>
	    </executions>
	    <configuration>
	      <outputDirectory>${claudia.distributionDirectory}</outputDirectory>
              <imageName>claudia</imageName>
	      <mainClass>com.quaxt.claudia.ClaudiaCli</mainClass>
	      <buildArgs>
		<buildArg>--no-fallback</buildArg>
		<buildArg>-Os</buildArg>
		<!--
		    The interactive terminal calls termios and ioctl through java.lang.foreign,
		    which GraalVM 25 supports by default; its downcalls are registered in
		    reachability-metadata.json.
		-->
		<buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
		<buildArg>-H:IncludeResources=quaxt/claudia/ai/models/.*\.json</buildArg>
	      </buildArgs>
	    </configuration>
	  </plugin>
	</plugins>
      </build>
    </profile>
  </profiles>
</project>
