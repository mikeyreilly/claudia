<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>works.earendil.pi</groupId>
		<artifactId>pi-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>pi-cli</artifactId>
	<name>pi-cli</name>
	<description>Coding agent CLI (Java port of @earendil-works/pi-coding-agent)</description>

	<dependencies>
		<dependency>
			<groupId>works.earendil.pi</groupId>
			<artifactId>pi-ai</artifactId>
		</dependency>
		<dependency>
			<groupId>works.earendil.pi</groupId>
			<artifactId>pi-agent</artifactId>
		</dependency>
		<dependency>
			<groupId>works.earendil.pi</groupId>
			<artifactId>pi-tui</artifactId>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Keep the module-only JAR away from the runnable JAR's stable path. -->
		<finalName>pi-cli-thin</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!--
								Never write directly to pi-cli.jar: a running JVM loads classes
								lazily, so mutating that archive can make classes disappear
								mid-session. Shade writes a temporary file first; the following
								execution publishes it with a rename, preserving the inode used
								by any already-running process.
							-->
							<outputFile>${project.build.directory}/pi-cli.next.jar</outputFile>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>works.earendil.pi.cli.Main</mainClass>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>publish-shaded-jar</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<move
									file="${project.build.directory}/pi-cli.next.jar"
									tofile="${project.build.directory}/pi-cli.jar"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>pi</imageName>
							<mainClass>works.earendil.pi.cli.Main</mainClass>
							<buildArgs>
								<buildArg>--no-fallback</buildArg>
								<buildArg>-Os</buildArg>
								<buildArg>-H:IncludeResources=works/earendil/pi/ai/models/.*\.json</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
